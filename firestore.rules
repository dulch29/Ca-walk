rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validOptionalText(data, field) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || data[field] is string;
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'displayName', 'avatarUrl', 'email', 'createdAt', 'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && validOptionalText(data, 'avatarUrl')
        && validOptionalText(data, 'email');
    }

    function validActivity(data, activityId) {
      return data.keys().hasOnly([
          'sessionId', 'sport', 'steps', 'distanceKm', 'durationSeconds',
          'averagePace', 'startedAt', 'endedAt', 'createdAt'
        ])
        && data.sessionId == activityId
        && data.sport == 'walk'
        && data.steps is int
        && data.steps >= 0
        && data.distanceKm is number
        && data.distanceKm >= 0
        && data.durationSeconds is int
        && data.durationSeconds >= 0
        && data.averagePace is string
        && data.startedAt is timestamp
        && data.endedAt is timestamp
        && data.createdAt is timestamp
        && data.endedAt >= data.startedAt;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'avatarUrl', 'email', 'updatedAt'
        ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /activities/{activityId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && !exists(/databases/$(database)/documents/users/$(uid)/activities/$(activityId))
          && validActivity(request.resource.data, activityId);
        allow update, delete: if false;
      }

      match /coupons/{couponId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }
    }

    match /merchants/{merchantId} {
      allow read: if true;
      allow write: if false;
    }

    match /missions/{missionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
